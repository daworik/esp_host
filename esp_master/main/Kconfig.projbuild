menu "ESP-NOW Drone Hive Configuration"

    config DRONE_HIVE_MAX_DRONES
        int "Maximum number of drones"
        default 10
        range 1 20
        help
            Maximum number of drone agents that can be controlled by this master.

    config DRONE_HIVE_ENCRYPTION_KEY
        string "ESP-NOW Encryption Key (32 bytes hex)"
        default "1a2b3c4d5e6f7a8b9cadbecfd0e1f2031425364758697a8b9cadbecfd0e1f203"
        help
            PMK encryption key for ESP-NOW communication (64 hex characters = 32 bytes).
            Must match on all drones.

    config DRONE_HEARTBEAT_TIMEOUT_MS
        int "Drone heartbeat timeout (ms)"
        default 3000
        range 1000 10000
        help
            Time after which a drone is considered inactive if no telemetry received.

endmenu
