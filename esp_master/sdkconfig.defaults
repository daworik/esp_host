# ESP-NOW Drone Hive Master - SDK Configuration Defaults

# Enable ESP-NOW
CONFIG_ESPNOW_ENABLED=y

# WiFi configuration for ESP-NOW (STA mode required)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# NVS flash storage
CONFIG_NVS_FLASH_ENCRYPTION=n
CONFIG_NVS_SECURE_READ_WRITE=n

# Timer support
CONFIG_ESP_TIMER_IMPL_TG0=y

# UART driver
CONFIG_UART_ISR_IN_IRAM=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# ESP-NOW encryption support
CONFIG_ESP_NOW_SECURITY=y
